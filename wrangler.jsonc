{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"growth-finance",
 "main":"worker/index.ts",
 "compatibility_date":"2026-09-25",
 "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
 "d1_databases":[{"binding":"DB","database_name":"growth-finance","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"worker/migrations"}],
 "vars":{"APP_ORIGIN":"http://localhost:8081","ALLOW_SIGNUP":"true"}
}
