{
  "expo": {
    "name": "Growth Finance",
    "slug": "growth-finance",
    "scheme": "growthfinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.growthfinance.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Growth Finance"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen"
    ]
  }
}
